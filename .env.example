# Supabase (plan free) — Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Generar con: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Gmail (gratis, límite ~500 mails/día). Requiere una "contraseña de
# aplicación" de Google, no la contraseña normal de la cuenta.
# Guía: myaccount.google.com/apppasswords (necesita 2FA activado)
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=
# Nombre que se muestra como remitente (opcional)
GMAIL_FROM_NAME="nmtech solutions"

# El mail de contacto público de /contacto ya NO se configura acá: se edita
# desde /admin → Configuración → Contacto.

# URL pública del sitio (sin / al final), para armar links absolutos dentro
# de los mails (variable {link} en las plantillas). En producción, poner acá
# el dominio real (ej. https://www.nmtechsolutions.com).
SITE_URL=http://localhost:3000

# Píxel de Meta (Facebook/Instagram Ads). Se obtiene en Meta Business Manager
# > Orígenes de datos > Píxeles. Es público (va al navegador), por eso lleva
# el prefijo NEXT_PUBLIC_. Dejar vacío para no cargar el Píxel.
NEXT_PUBLIC_META_PIXEL_ID=

# Token de acceso de la API de Conversiones de Meta (server-side), para el
# mismo Píxel de arriba. Se genera en Meta Business Manager > Orígenes de
# datos > Píxeles > tu píxel > Configuración > API de conversiones >
# "Generar token de acceso manualmente". NUNCA debe llevar NEXT_PUBLIC_: es
# secreto, solo se usa desde el servidor. Dejar vacío para desactivar el
# envío server-side (el Píxel del navegador sigue funcionando igual).
META_CONVERSIONS_API_TOKEN=
